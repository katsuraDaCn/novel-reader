    "test:text": "node test/gen-samples.js && node test/test-text.js",
    "test:security": "node test/test-security.js"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.5.1",
    "iconv-lite": "^0.7.3"
  }
}
